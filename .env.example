# Copie para .env e preencha. 
# O driver "+asyncpg" é obrigatório: a aplicação usa engine assíncrona.
# O host "db" é o nome do serviço no docker-compose.
DATABASE_URL=postgresql+asyncpg://usuario:suasenha@db:5432/skyroute

# Banco separado, só para a série histórica de 15 dias. Fica em outro container
# para não disputar recurso com a coleta operacional.
HISTORICO_DATABASE_URL=postgresql+asyncpg://usuario:suasenha@db_historico:5432/skyroute_historico
HISTORICO_DIAS=15

# Credenciais dos containers do Postgres. Precisam bater com as URLs acima.
POSTGRES_USER=usuario
POSTGRES_PASSWORD=suasenha
POSTGRES_DB=skyroute
POSTGRES_HISTORICO_DB=skyroute_historico

# Chave da REDEMET: cadastro gratuito em https://redemet.decea.mil.br, será fornecida na descrição da entrega do MVP.
REDEMET_BASE_URL=https://api-redemet.decea.mil.br
REDEMET_API_KEY=sua_chave_aqui

AISWEB_BASE_URL=https://api.decea.mil.br/aisweb/
AISWEB_API_KEY=
AISWEB_API_PASS=

# Intervalo da coleta automática em minutos.
COLLECTOR_INTERVAL_MINUTES=60

DB_ECHO=false


# AISWEB (DECEA): nascer/pôr do sol e dados de aeródromo, para o VFR Especial (Art. 134). 
# O Cadastro é gratuito de apiKey/apiPass em https://aisweb.decea.mil.br/?i=publicacoes&p=api e 
# será fornecida na descrição da entrega do MVP para possibilitar o avaliador ativar o acesso.
# O app funciona normalmente sem essa API, só nunca classifica VFR Especial e cai em "abaixo
# dos mínimos", que é o padrão conservador quando falta o dado.

